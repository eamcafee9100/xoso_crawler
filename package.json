{
  "name": "xoso-crawler-tests",
  "version": "1.0.0",
  "description": "Test suite for xoso_crawler predictions_tracker JavaScript functions",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "test:loadMethodAnalysis": "jest predictions_tracker/static/js/test/loadMethodAnalysis.test.js",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:silent": "jest --silent",
    "test:bail": "jest --bail",
    "test:updateSnapshot": "jest --updateSnapshot"
  },
  "keywords": [
    "javascript",
    "testing",
    "jest",
    "xoso",
    "predictions",
    "analysis"
  ],
  "author": "xoso_crawler_team",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "babel-jest": "^29.6.0",
    "jest": "^29.6.0",
    "jest-environment-jsdom": "^29.6.0"
  },
  "babel": {
    "presets": [
      ["@babel/preset-env", {
        "targets": {
          "node": "current"
        }
      }]
    ]
  }
}
