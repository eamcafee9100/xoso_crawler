{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "verbose": {
      "format": "{levelname} {asctime} {module} {process:d} {thread:d} {message}",
      "style": "{"
    },
    "simple": {
      "format": "{levelname} {message}",
      "style": "{"
    }
  },
  "handlers": {
    "file": {
      "level": "INFO",
      "class": "logging.handlers.RotatingFileHandler",
      "filename": "C:\\Users\\n2t\\Documents\\xoso_crawler\\logs\\django.log",
      "maxBytes": 15728640,
      "backupCount": 10,
      "formatter": "verbose"
    },
    "console": {
      "level": "INFO",
      "class": "logging.StreamHandler",
      "formatter": "simple"
    }
  },
  "root": {
    "handlers": [
      "console",
      "file"
    ],
    "level": "INFO"
  },
  "loggers": {
    "django": {
      "handlers": [
        "console",
        "file"
      ],
      "level": "INFO",
      "propagate": false
    },
    "predictions_tracker": {
      "handlers": [
        "console",
        "file"
      ],
      "level": "DEBUG",
      "propagate": false
    }
  }
}